categorys={
    'a':['1','2','3'],
    'b':['4','5','6'],
    'c':['7','8','9']
}
#categorysは現在仮の値が入っています

def add_item(category,item):    #categoryにitemを追加します　　すでに同じ名前のものがあればprintします
    have_category=0
    have_item=0
    for i in categorys:
        if category==i:
            have_category=1
            for j in categorys[i]:
                if j==item:
                    have_item=1
            if have_item==0:
                categorys[i].append(item)
    if have_category==0:
        print('指定されたカテゴリーがありません')
    if have_item==1:
        print('指定されたアイテムはすでにあります')

def delete_item(category,item):    #categoryのitemを削除します　　同じ名前のものがなければprintします
    have_category=0
    have_item=0
    for i in categorys:
        if category==i:
            have_category=1
            for j in categorys[i]:
                if j==item:
                    have_item=1
                    categorys[i].remove(item)
    if have_category==0:
        print('指定されたカテゴリーがありません')
    if have_item==0:
        print('指定されたアイテムはありません')

def add_category(category):    #categoryを追加します　　同じ名前のものがあればprintします
    have_category=0
    have_item=0
    for i in categorys:
        if category==i:
            have_category=1
    if have_category==1:
        print('そのカテゴリー名はすでに存在します')
    else:
        categorys[category]=[]
    print(categorys)

def delete_category(category):    #categoryを削除します　　同じ名前のものがなければprintします
    have_category=0
    have_item=0
    for i in categorys:
        if category==i:
            have_category=1
    if have_category==0:
        print('そのカテゴリー名はありません')
    else:
        del categorys[category]
    print(categorys)
