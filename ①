import ipywidgets as widgets
from IPython.display import display, HTML, clear_output
from datetime import datetime, timedelta

# 持ち物データ保存用リスト
items = []

# アプリの見た目設定
display(HTML("""
<style>
    .item-card { background-color: #2b2b36; color: #fff; padding: 10px 15px; border-radius: 8px; margin-bottom: 8px; }
    .badge { padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 12px; color: white; }
    .badge-1 { background-color: #2b8a3e; }
    .badge-2 { background-color: #1971c2; }
    .badge-3 { background-color: #e67e22; }
    .badge-4 { background-color: #d9480f; }
    .badge-5 { background-color: #c92a2a; animation: blink 1s infinite; }
    @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
</style>
"""))

# 入力フォームの作成
txt_name = widgets.Text(description="持ち物名:", placeholder="例: 財布、パスポート", style={'description_width': 'initial'})
dd_importance = widgets.Dropdown(
    options=[
        ("★1 (低 - 直前1回)", 1),
        ("★2 (やや低 - 10分前/直前)", 2),
        ("★3 (中 - 15分/5分前/直前)", 3),
        ("★4 (高 - 30/15/5分前/直前)", 4),
        ("★5 (超重要 - 60/30/15/5/1分前/直前)", 5),
    ],
    value=3,
    description="重要度:",
    style={'description_width': 'initial'}
)
txt_minutes = widgets.BoundedIntText(value=30, min=1, max=1440, description="出発予定(分後):", style={'description_width': 'initial'})
btn_add = widgets.Button(description="＋ 追加する", button_style="success", icon="plus")

out_list = widgets.Output()

def render_list():
    with out_list:
        clear_output(wait=True)
        if not items:
            print("持ち物が登録されていません。")
            return
        
        now = datetime.now()
        for idx, item in enumerate(items):
            target_dt = datetime.fromisoformat(item["departure_time"])
            diff_min = int((target_dt - now).total_seconds() // 60)
            
            trigger_counts = {1: 1, 2: 2, 3: 3, 4: 4, 5: 7}
            count = trigger_counts[item["importance"]]
            
            time_str = "✅ 完了" if item["checked"] else (f"あと {diff_min} 分" if diff_min > 0 else "🚨 出発時刻！")
            star_str = "★" * item["importance"]
            
            chk = widgets.Checkbox(value=item["checked"], description=item["name"], indent=False)
            btn_del = widgets.Button(description="削除", button_style="danger", icon="trash", layout=widgets.Layout(width="80px"))
            
            def make_toggle(i):
                return lambda change: toggle_check(i, change['new'])
            def make_delete(i):
                return lambda b: delete_item(i)
                
            chk.observe(make_toggle(idx), names='value')
            btn_del.on_click(make_delete(idx))
            
            badge_html = widgets.HTML(f"<span class='badge badge-{item['importance']}'>{star_str}</span> <span style='margin-left:8px;'>通知設定: <b>{count}回</b> | 状態: {time_str}</span>")
            row = widgets.HBox([chk, badge_html, btn_del], layout=widgets.Layout(justify_content="space-between", align_items="center", margin="5px 0"))
            display(row)

def add_item(b):
    name = txt_name.value.strip()
    if not name: return
    
    departure_dt = datetime.now() + timedelta(minutes=txt_minutes.value)
    items.append({
        "name": name,
        "importance": dd_importance.value,
        "departure_time": departure_dt.isoformat(),
        "checked": False
    })
    txt_name.value = ""
    render_list()

def toggle_check(idx, status):
    items[idx]["checked"] = status
    render_list()

def delete_item(idx):
    del items[idx]
    render_list()

btn_add.on_click(add_item)

# 画面表示
display(
    widgets.HTML("<h2>🎒 持ち物チェック＆重要度リマインダー</h2>"),
    widgets.VBox([txt_name, dd_importance, txt_minutes, btn_add], layout=widgets.Layout(padding="15px", border="1px solid #444", border_radius="8px", margin="0 0 15px 0")),
    widgets.HTML("<h3>📋 持ち物一覧</h3>"),
    out_list
)
render_list()
